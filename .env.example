# Doctor portal authentication
# SESSION_SECRET must be unique and at least 32 characters. Generate one with:
# openssl rand -base64 48
SESSION_SECRET=
DOCTOR_EMAIL=
DOCTOR_PASSWORD=

# Supabase (required for cross-device sync, realtime updates, and patient accounts)
# See docs/SUPABASE_SETUP.md. VITE_* vars are baked in at BUILD time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Voice/video calls (Jitsi): use the public meet.jit.si instance — no API key
# or env vars required. To enable calls, apply
# supabase/migrations/20260825120000_video_call_jitsi_rooms.sql in Supabase
# (see docs/SUPABASE_SETUP.md section 5).
#
# OPTIONAL — only if your network blocks meet.jit.si: point calls at another
# public or self-hosted Jitsi instance (must allow iframe embedding):
# VITE_JITSI_DOMAIN=jitsi.example.com
