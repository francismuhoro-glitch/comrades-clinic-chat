# Doctor portal authentication
# SESSION_SECRET must be unique and at least 32 characters. Generate one with:
# openssl rand -base64 48
SESSION_SECRET=
DOCTOR_EMAIL=
DOCTOR_PASSWORD=

# In-app notifications (the 🔔 bell) need NO extra keys — they run on the
# notifications table + Supabase Realtime. Outbound SMS/WhatsApp/email adapters
# are planned; when added they will read their keys here.

# Admin console (/admin): server-side key that lets admins create doctor
# accounts with email + password. Server-side only — NEVER use a VITE_ prefix.
# Without it, admins can still promote existing accounts (sign up via My
# Visits, then set the role in /admin).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (required for cross-device sync, realtime updates, and patient accounts)
# See docs/SUPABASE_SETUP.md. VITE_* vars are baked in at BUILD time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Voice/video calls (Jitsi): use the public meet.jit.si instance — no API key
# required. To enable calls, apply
# supabase/migrations/20260825120000_video_call_jitsi_rooms.sql in Supabase
# (see docs/SUPABASE_SETUP.md section 5).
# On meet.jit.si the call room opens in its own browser tab (meet.jit.si
# disconnects *embedded* rooms after 5 minutes; tab-based rooms are unlimited).
#
# OPTIONAL — for in-app embedded calls (no 5-minute concern), point this at
# your own self-hosted Jitsi instance that allows iframe embedding:
# VITE_JITSI_DOMAIN=jitsi.example.com
